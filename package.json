{
  "name": "aho-corasick-node-rs",
  "version": "0.1.9",
  "description": "Aho-Corasick Rust library Node.js bindings",
  "main": "lib/index.js",
  "author": "Vladimir Skvortsov <vlad@whereto.com>",
  "license": "MIT",
  "engines": {
    "node": ">=10.12.0"
  },
  "dependencies": {
    "@mapbox/node-pre-gyp": "^1.0.11"
  },
  "os": [
    "darwin",
    "linux"
  ],
  "cpu": [
    "x64",
    "arm64"
  ],
  "scripts": {
    "install": "node-pre-gyp install --fallback-to-build=false || PATH=$HOME/.cargo/bin:$PATH node scripts/build-native.js",
    "build": "node scripts/build-native.js --debug",
    "build:release": "node scripts/build-native.js",
    "package": "node-pre-gyp package",
    "bench": "node lib/index.bench.js",
    "test": "jest lib"
  },
  "binary": {
    "module_name": "index",
    "host": "https://github.com/wherefortravel/aho-corasick-node-rs/releases/download/",
    "remote_path": "{version}",
    "package_name": "napi-{platform}-{arch}.tar.gz",
    "module_path": "./prebuilt",
    "pkg_path": "."
  },
  "files": [
    "lib/index.js",
    "scripts",
    "native/src",
    "native/Cargo.lock",
    "native/Cargo.toml"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wherefortravel/aho-corasick-node-rs.git"
  },
  "devDependencies": {
    "@mapbox/node-pre-gyp": "^1.0.11",
    "aho-corasick-node": "^1.0.2",
    "benchmark": "^2.1.4",
    "jest": "^27.5.1"
  }
}
